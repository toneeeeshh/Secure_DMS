# Copy this file to .env and fill in real values before deploying.
# Never commit your actual .env file.

# Required in production: a long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# development | production
NODE_ENV=development

# Port the server listens on (most hosting platforms set this automatically)
PORT=4000
